<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.examenRecup.controller.MainController"
            prefHeight="400.0" prefWidth="600.0">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #f4f4f4; -fx-padding: 15px 20px;">
            <Label fx:id="welcomeLabel" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #333" text="Welcome, User!"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleLogout" style="-fx-background-color: #E0F7FA; -fx-text-fill: #00838f; -fx-border-color: #00ACC1; -fx-border-radius: 3; -fx-background-radius: 3;" text="Logout"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #F4F4F4; -fx-border-color: transparent;">
            <FlowPane fx:id="cardsContainer" hgap="25.0" vgap="25.0" alignment="TOP_LEFT" style="-fx-padding: 20px;"/>
        </ScrollPane>
    </center>

    <right>
        <VBox fx:id="adminPanel" prefWidth="320.0" spacing="12.0">
            <Label text="Admin Control Panel"/>

            <Separator/>

            <Label text="Manage User"/>

            <VBox spacing="6.0">
                <Label text="ID (Read only for edit)"/>
                <TextField fx:id="idField" disable="true"/>
                <Label text="Nombre:"/>
                <TextField fx:id="nombreField"/>
                <Label text="Nickname: "/>
                <TextField fx:id="nicknameField"/>
                <Label text="Email: "/>
                <TextField fx:id="emailField"/>
                <Label text="Edad: "/>
                <TextField fx:id="edadField"/>
                <Label text="Password"/>
                <PasswordField fx:id="passwordField"/>
                <Label text="Role:"/>
                <ComboBox fx:id="roleComboBox" prefWidth="280.0"/>
            </VBox>
            <HBox alignment="CENTER" spacing="10.0">
                <Button onAction="#clearForm" style="-fx-background-color: white; -fx-text-fill: #333;" text="Clear"/>
                <Button onAction="#handleAdd" style="-fx-background-color: green; -fx-text-fill: #333;" text="Add"/>
                <Button onAction="#handleUpdate" style="-fx-background-color: blue; -fx-text-fill: #333;" text="Update"/>
                <Button onAction="#handleDelete" style="-fx-background-color: red; -fx-text-fill: #333;" text="Delete"/>
            </HBox>
            <Label fx:id="adminMessageLabel" wrapText="true"/>
        </VBox>
    </right>
</BorderPane>
